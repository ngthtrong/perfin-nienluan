# API and PostgreSQL
PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=demodb
DB_USER=postgres
DB_PASSWORD=password

# AI (use AI_PROVIDER=local to run without an external LLM)
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MODEL_LIST_TIMEOUT_MS=5000

# Redis-backed KV and BullMQ. Setting REDIS_ENABLED=false keeps the API's
# in-memory KV fallback and makes the standalone worker exit successfully.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Proactive worker
JOBS_ENABLED=true
JOBS_QUEUE_NAME=perfin-proactive
JOBS_TIMEZONE=Asia/Bangkok
JOBS_CONCURRENCY=3
JOBS_STARTUP_TIMEOUT_MS=5000

# BullMQ cron patterns (minute hour day-of-month month day-of-week)
JOB_RECURRING_ENABLED=true
JOB_RECURRING_CRON=0 8 * * *
JOB_RUNWAY_ENABLED=true
JOB_RUNWAY_CRON=15 8 * * *
JOB_RUNWAY_ALERT_DAYS=14
JOB_SUBSCRIPTION_ENABLED=true
JOB_SUBSCRIPTION_CRON=30 8 * * 1
JOB_MONTH_END_ENABLED=true
JOB_MONTH_END_CRON=0 20 28-31 * *
JOB_MONTH_END_AUTO_EXPORT=false
JOB_EXPORT_CLEANUP_ENABLED=true
JOB_EXPORT_CLEANUP_CRON=0 3 * * *
JOB_EXPORT_CLEANUP_BATCH_SIZE=100

# Local media AI. Raw media stays on the backend host; extracted text may be
# sent to Gemini for transaction extraction when the Gemini provider is selected.
MEDIA_AI_OFFLINE=true
MEDIA_AI_TIMEOUT_MS=120000
MEDIA_AI_CACHE_DIR=.cache/media-ai
MEDIA_AI_PYTHON=.venv-ai/bin/python
OCR_LANG=vi
PHOWHISPER_MODEL=vinai/PhoWhisper-small
