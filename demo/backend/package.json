{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "worker": "node scripts/worker.js",
    "worker:dev": "node --watch scripts/worker.js",
    "migrate": "node scripts/migrate.js",
    "migrate:fresh": "node scripts/migrate.js --fresh",
    "seed": "node scripts/migrate.js --seed-only",
    "test": "node --test tests/*.test.js",
    "test:ai": "node tests/ai-accuracy-test.js",
    "test:algorithm": "node tests/experiments/algorithm-correctness.js --out ../evaluation/algorithm",
    "benchmark:algorithms": "node tests/experiments/algorithm-performance.js --out ../evaluation/algorithm",
    "benchmark:classification": "node tests/experiments/classification-benchmark.js --out ../evaluation/algorithm",
    "evaluate:algorithm": "npm run test:algorithm && npm run benchmark:algorithms && npm run benchmark:classification",
    "test:jobs": "node --test tests/jobs.test.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:full": "node scripts/smoke-test.js --write --media",
    "data:profile": "node scripts/import-finance-csv.js --dry-run",
    "data:import": "node scripts/import-finance-csv.js --apply --replace",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:fresh": "node scripts/seed-demo.js --clear",
    "setup:media-ai": "python3 -m venv .venv-ai && .venv-ai/bin/python -m pip install --upgrade pip && .venv-ai/bin/pip install -r requirements-ai.txt"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.7.0",
    "bullmq": "^5.80.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "pg": "^8.21.0"
  }
}
