        <mxCell id="arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="matcher" target="preview">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr3-label" value="3. Match&#xa;to DB" style="edgeLabel;html=1;align=center;fontSize=11;" vertex="1" connectable="0" parent="arr3">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
            <mxPoint y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="preview" target="user-choice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#00AA00;" edge="1" parent="1" source="user-choice" target="accept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr5-label" value="Accept" style="edgeLabel;html=1;align=center;fontSize=11;fontColor=#00AA00;" vertex="1" connectable="0" parent="arr5">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arr6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#D79B00;" edge="1" parent="1" source="user-choice" target="edit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr6-label" value="Edit" style="edgeLabel;html=1;align=center;fontSize=11;fontColor=#D79B00;" vertex="1" connectable="0" parent="arr6">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
            <mxPoint x="10" y="-1" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arr7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#B85450;" edge="1" parent="1" source="edit" target="log-correction">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="400" />
              <mxPoint x="230" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arr7-label" value="4. Log correction" style="edgeLabel;html=1;align=center;fontSize=11;fontColor=#B85450;fontStyle=1" vertex="1" connectable="0" parent="arr7">
          <mxGeometry x="0.25" y="2" relative="1" as="geometry">
            <mxPoint x="-35" y="-8" as="offset" />
          </mxGeometry>
