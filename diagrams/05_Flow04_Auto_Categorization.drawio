        <!-- Notes -->
        <mxCell id="note1" value="Why LLM is Critical:&#xa;• Context understanding: &quot;grab bệnh viện&quot; → Y tế (not keyword)&#xa;• Learns from user behavior (few-shot)&#xa;• Discovers hidden patterns&#xa;• No rule-based system can match this flexibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="360" height="60" as="geometry" />
        </mxCell>

