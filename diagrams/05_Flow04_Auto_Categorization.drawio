        </mxCell>

        <mxCell id="arr10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="few-shot" target="llm-suggest">
          <mxGeometry relative="1" as="geometry">
