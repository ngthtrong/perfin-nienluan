<mxfile host="app.diagrams.net">
  <diagram id="flow4-categorization" name="Flow 4: Auto-Categorization + Feedback">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="title" value="Flow 4: Context-Aware Auto-Categorization + Feedback Loop (REQ-02)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="920" height="40" as="geometry" />
        </mxCell>

        <!-- Main Flow -->
        <mxCell id="input" value="New Transaction Input&#xa;(from text/voice/image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="llm-suggest" value="LLM Analysis&#xa;(Context-aware categorization)&#xa;&#xa;Example:&#xa;&quot;grab đi bệnh viện&quot;&#xa;→ Y tế (not Di chuyển)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="matcher" value="Category Matcher&#xa;(3-tier matching)&#xa;&#xa;1. Exact match&#xa;2. Substring match&#xa;3. Alias match&#xa;4. Fallback: &quot;Khác&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="85" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="preview" value="Transaction Preview&#xa;with suggested category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="user-choice" value="User Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="890" y="220" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="accept" value="Accept Suggestion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="240" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="edit" value="Edit Category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="340" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Feedback Loop -->
        <mxCell id="feedback-box" value="Feedback Loop System (REQ-02)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="960" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="log-correction" value="Log Correction&#xa;ai_feedback_logs table&#xa;&#xa;• AI original: Di chuyển&#xa;• User corrected: Y tế&#xa;• Context: &quot;grab bệnh viện&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="feedback-box">
          <mxGeometry x="40" y="40" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="pattern-learning" value="Pattern Learning&#xa;&#xa;Build correction history:&#xa;• &quot;grab bệnh viện&quot; → Y tế&#xa;• &quot;grab phòng khám&quot; → Y tế&#xa;• &quot;grab siêu thị&quot; → Ăn uống&#xa;&#xa;→ Context matters!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="feedback-box">
          <mxGeometry x="300" y="40" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="few-shot" value="Few-Shot Context&#xa;&#xa;Next LLM call includes:&#xa;&quot;User typically categorizes&#xa;'grab bệnh viện' as Y tế,&#xa;not Di chuyển&quot;&#xa;&#xa;→ Personalized learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1" vertex="1" parent="feedback-box">
          <mxGeometry x="590" y="40" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- Category Discovery -->
        <mxCell id="discovery-box" value="Advanced: Category Discovery (Proposed)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="960" height="140" as="geometry" />
        </mxCell>

        <mxCell id="miner" value="Subscription Miner&#xa;&#xa;Detect patterns:&#xa;• N transactions with&#xa;  same keyword&#xa;• All fall into &quot;Khác&quot;&#xa;• Suggest new category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="discovery-box">
          <mxGeometry x="40" y="40" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="suggest-new" value="AI Suggests:&#xa;&quot;You have 8 'cà phê'&#xa;transactions in Ăn uống.&#xa;Create 'Cà phê' subcategory?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="discovery-box">
          <mxGeometry x="300" y="40" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="retag" value="Re-tag Service&#xa;&#xa;If user accepts:&#xa;1. Create new category&#xa;2. Re-tag old transactions&#xa;3. Update AI context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="discovery-box">
          <mxGeometry x="620" y="40" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="input" target="llm-suggest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr1-label" value="1. Parse" style="edgeLabel;html=1;align=center;fontSize=11;fontColor=#0000FF;" vertex="1" connectable="0" parent="arr1">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9673A6;" edge="1" parent="1" source="llm-suggest" target="matcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr2-label" value="2. Suggest&#xa;category" style="edgeLabel;html=1;align=center;fontSize=11;fontColor=#9673A6;" vertex="1" connectable="0" parent="arr2">
          <mxGeometry x="-0.05" y="1" relative="1" as="geometry">
