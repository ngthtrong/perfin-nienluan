        <mxCell id="arr10-label" value="5. Use in next parse&#xa;(Few-shot learning)" style="edgeLabel;html=1;align=center;fontSize=11;fontColor=#9673A6;fontStyle=1" vertex="1" connectable="0" parent="arr10">
          <mxGeometry x="0.55" y="2" relative="1" as="geometry">
