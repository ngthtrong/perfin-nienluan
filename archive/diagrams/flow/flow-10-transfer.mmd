---
title: "Luồng 10 — Chuyển tiền giữa các ví (Transfer)"
---
flowchart TD
    START([User: 'chuyển 500k\ntừ ví chính sang tiết kiệm']) --> POST[POST /api/chat/message]
    POST --> GEMINI[Gemini parse\nintent = transfer]

    GEMINI --> EXTRACT[Extract:\n- amount: 500.000đ\n- ví nguồn: ví chính\n- ví đích: tiết kiệm]

    EXTRACT --> RESOLVE[Resolve tên ví\nsang wallet_id trong DB\nHỗ trợ tên tiếng Việt tự nhiên]

    RESOLVE --> BALANCE[Truy vấn số dư\nví nguồn hiện tại]

    BALANCE --> ENOUGH{Số dư\nđủ không?}

    ENOUGH -->|Không đủ| INSUF[type = clarification\n'Ví chính chỉ còn Xk,\nkhông đủ để chuyển 500k']

    ENOUGH -->|Đủ| ATOMIC

    subgraph ATOMIC["Atomic Transaction — 2 bản ghi đồng thời"]
        AT1[Giao dịch 1:\nDebit ví nguồn\ntype = transfer_out\namount = -500k]
        AT2[Giao dịch 2:\nCredit ví đích\ntype = transfer_in\namount = +500k]
        AT1 -.->|Cùng DB transaction| AT2
    end

    ATOMIC --> BALANCE_UPDATE[Cập nhật số dư\nCả 2 ví đồng thời]

    BALANCE_UPDATE --> CONFIRM[type = system_message\n'Đã chuyển 500k từ Ví chính → Tiết kiệm\nVí chính: 1.3tr | Tiết kiệm: 2.0tr']

    subgraph NOTE["Phân biệt 3 loại giao dịch"]
        N1["💸 Expense — chi tiêu\nNet Worth giảm"]
        N2["🔄 Transfer — điều chuyển\nNet Worth không đổi"]
        N3["📈 Investment — đầu tư\nCơ cấu tài sản thay đổi"]
    end

    style ATOMIC fill:#e8f5e9,stroke:#388e3c
    style AT1 fill:#fce4ec,stroke:#e91e63
    style AT2 fill:#e3f2fd,stroke:#1976d2
    style CONFIRM fill:#d4edda,stroke:#28a745
    style INSUF fill:#fff3cd,stroke:#ffc107
    style N2 fill:#cce5ff,stroke:#0056b3
