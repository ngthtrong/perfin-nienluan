---
title: "Luồng 8 — Chat hỏi đáp tự do với AI (General AI Chat)"
---
flowchart TD
    START([User nhắn câu hỏi / tư vấn\nvd: 'Tôi nên tiết kiệm bao nhiêu?']) --> POST[POST /api/chat/message]

    POST --> PARSE[AIService.parseTransaction\n→ Gemini phân tích intent]

    PARSE --> INTENT{intent?}

    INTENT -->|transaction / recurring_*| TX[Xử lý luồng\ngiao dịch tương ứng]
    INTENT -->|question / greeting / unclear| CHAT_FLOW

    subgraph CHAT_FLOW["Chat Flow — General Q&A"]
        HISTORY[ChatMessage.getRecent\n→ Lấy 10 tin nhắn gần nhất]
        CONTEXT["Xây dựng context:\n• Persona user\n• Lịch sử chat\n• Tóm tắt tài chính\n(số dư, ngân sách)"]
        CHATPROMPT["getChatPrompt(text, context)\n→ Gemini API"]
        RESP["AI trả lời dựa trên:\n• Data tài chính thực của user\n• Ngữ cảnh hội thoại\n• Persona đã chọn"]

        HISTORY --> CONTEXT --> CHATPROMPT --> RESP
    end

    CHAT_FLOW --> SAVE[Lưu vào chat_messages\nrole = assistant]
    SAVE --> DISPLAY[Frontend: bubble chat thường\ntype = chat_response]

    subgraph PERSONA["Persona ảnh hưởng tone (dự kiến)"]
        P1["🏋️ Chuyên gia:\n'Dựa trên quy tắc 50/30/20...'"]
        P2["👩 Bà mẹ:\n'Con ơi tiết kiệm đi không\nthì cuối tháng cạn túi!'"]
        P3["👫 Bạn thân:\n'Ê mày ít ra tiết kiệm\n20% mỗi tháng nha'"]
    end

    RESP -.->|applyPersona - dự kiến| P1
    RESP -.->|applyPersona - dự kiến| P2
    RESP -.->|applyPersona - dự kiến| P3

    style CHAT_FLOW fill:#e8f5e9,stroke:#388e3c
    style DISPLAY fill:#d4edda,stroke:#28a745
    style P1 fill:#e3f2fd,stroke:#1976d2
    style P2 fill:#fce4ec,stroke:#e91e63
    style P3 fill:#fffde7,stroke:#f9a825
