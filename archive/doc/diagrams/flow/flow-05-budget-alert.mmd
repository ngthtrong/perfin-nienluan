---
title: "Luồng 5 — Cảnh báo ngân sách chủ động (Proactive Budget Alert)"
---
flowchart TD
    START([Giao dịch expense\nxác nhận lưu DB thành công]) --> TRIGGER[transaction.routes.js\ntrigger kiểm tra budget]

    TRIGGER --> QUERY_CAT[Tính tổng chi tiêu\ntheo danh mục trong kỳ]
    TRIGGER --> QUERY_TOTAL[Tính tổng chi tiêu\ntổng thể trong kỳ]

    QUERY_CAT --> COMPARE
    QUERY_TOTAL --> COMPARE

    COMPARE[So sánh với budget\nđã thiết lập trong DB\nbảng budgets]

    COMPARE --> THRESHOLD{Ngưỡng\nđạt được?}

    THRESHOLD -->|Dưới 70%| SAFE[Không cảnh báo]

    THRESHOLD -->|70% ≤ x < 90%| WARN70["⚠️ Sắp chạm giới hạn:\n'Bạn đã dùng 70% ngân sách\nĂn uống tháng này\n(1.400k/2.000k)'"]

    THRESHOLD -->|90% ≤ x < 100%| WARN90["🔴 Cảnh báo khẩn:\n'Bạn đã dùng 90% ngân sách\nĂn uống (1.800k/2.000k).\nChỉ còn 200k cho 8 ngày cuối'"]

    THRESHOLD -->|≥ 100%| EXCEED["🚨 Vượt ngân sách:\n'Ăn uống đã vượt 150k\nso với ngân sách tháng này'"]

    WARN70 --> PERSONA[applyPersona\n→ Format theo persona\n- dự kiến -]
    WARN90 --> PERSONA
    EXCEED --> PERSONA

    PERSONA --> INJECT[Chèn vào bảng\nchat_messages\nrole = assistant]

    INJECT --> DISPLAY[Frontend load chat\nhiển thị cảnh báo\nnhư tin nhắn thường]

    subgraph SCOPE["Phạm vi kiểm tra ngân sách"]
        CAT[Budget theo danh mục\nvd: Ăn uống ≤ 2tr/tháng]
        TOTAL[Budget tổng thể\nvd: Tổng chi ≤ 8tr/tháng]
        CAT --- TOTAL
    end

    style SAFE fill:#d4edda,stroke:#28a745
    style WARN70 fill:#fff3cd,stroke:#ffc107
    style WARN90 fill:#ffd7d7,stroke:#dc3545
    style EXCEED fill:#f8d7da,stroke:#dc3545
    style INJECT fill:#e2d9f3,stroke:#6f42c1
    style PERSONA stroke-dasharray: 5 5
