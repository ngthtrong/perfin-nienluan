        </mxCell>
        <mxCell id="f2-display" value="Display Transcript&#xa;+ Auto-send to chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="frontend">
