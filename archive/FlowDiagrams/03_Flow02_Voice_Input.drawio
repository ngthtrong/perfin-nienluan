          <mxGeometry x="160" y="400" width="920" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f2-phowhisper" value="PhoWhisper (Offline)&#xa;&#xa;Python subprocess&#xa;1. FFmpeg: convert to WAV 16kHz&#xa;2. Model: vinai/PhoWhisper-small&#xa;3. Return Vietnamese text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="stt-lane">
