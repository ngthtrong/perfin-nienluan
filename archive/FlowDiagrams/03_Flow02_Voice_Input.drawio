          <mxGeometry x="160" y="280" width="920" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2-route" value="ai.routes.js&#xa;POST /api/speech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="backend">
          <mxGeometry x="40" y="30" width="120" height="50" as="geometry" />
        </mxCell>
