\contentsline {figure}{\numberline {2}{\ignorespaces Kiến trúc vận hành của PERFIN. Lõi xác định tạo và lưu facts; AI Orchestrator chỉ điều phối ngữ nghĩa.}}{31}{figure.caption.19}%
\setforeignlanguage {vietnamese}
\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {3}{\ignorespaces Sơ đồ triển khai nguyên mẫu. Frontend, API, worker, PostgreSQL và Redis thuộc môi trường demo; provider AI được gọi qua mạng.}}{33}{figure.caption.21}%
\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {4}{\ignorespaces Mô hình miền theo aggregate nghiệp vụ. Các cụm dữ liệu tách khỏi service phân tích và lớp ngôn ngữ.}}{35}{figure.caption.22}%
\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {5}{\ignorespaces Sơ đồ quan hệ thực thể vật lý được đối chiếu với chuỗi migration runtime.}}{37}{figure.caption.23}%
\setforeignlanguage {vietnamese}
\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {6}{\ignorespaces Ranh giới trách nhiệm của LLM: dữ liệu và facts được tạo ở lõi xác định; LLM chỉ chuyển đổi ngữ nghĩa và diễn giải.}}{39}{figure.caption.25}%
\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {7}{\ignorespaces Máy trạng thái hội thoại và giao dịch chờ xác nhận.}}{40}{figure.caption.26}%
