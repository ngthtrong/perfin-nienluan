\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {10}{\ignorespaces Luồng phản hồi và cá nhân hóa phân loại bằng correction retrieval, không phải fine-tuning.}}{43}{figure.caption.29}%
\setforeignlanguage {vietnamese}
\contentsline {figure}{\numberline {11}{\ignorespaces Sơ đồ tuần tự sinh insight có căn cứ. Response trả cả thông điệp và facts để truy vết.}}{44}{figure.caption.30}%
