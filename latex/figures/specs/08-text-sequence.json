{
  "title": "Text Transaction Entry",
  "participants": [
    {"id": "user", "label": "User", "actor": true},
    {"id": "app", "label": "Mobile App"},
    {"id": "route", "label": "Chat Route"},
    {"id": "ai", "label": "AI Orchestrator"},
    {"id": "provider", "label": "Gemini / Local Parser"},
    {"id": "pending", "label": "Pending KV Store"},
    {"id": "db", "label": "PostgreSQL"}
  ],
  "messages": [
    {"from": "user", "to": "app", "label": "Enter: breakfast 50k", "activate": false},
    {"from": "app", "to": "route", "label": "POST /api/chat/message"},
    {"from": "route", "to": "db", "label": "Load categories and feedback"},
    {"from": "db", "to": "route", "label": "Categories and corrections", "return": true},
    {"from": "route", "to": "ai", "label": "parseTransaction(text, context)"},
    {"from": "ai", "to": "provider", "label": "Function calling or local rules"},
    {"note": "The LLM only proposes a typed command; no data is written", "over": "provider"},
    {"from": "provider", "to": "ai", "label": "Typed candidate and confidence", "return": true},
    {"from": "ai", "to": "route", "label": "Normalized result", "return": true},
    {"from": "route", "to": "pending", "label": "Store draft with TTL"},
    {"from": "pending", "to": "route", "label": "pending_id", "return": true},
    {"from": "route", "to": "app", "label": "Transaction preview", "return": true},
    {"from": "user", "to": "app", "label": "Edit or confirm", "activate": false},
    {"from": "app", "to": "route", "label": "POST /api/chat/confirm"},
    {"from": "route", "to": "pending", "label": "Read and claim draft"},
    {"from": "pending", "to": "route", "label": "Validated draft", "return": true},
    {"from": "route", "to": "db", "label": "BEGIN · INSERT transaction · update wallet · COMMIT"},
    {"from": "db", "to": "route", "label": "Saved transaction", "return": true},
    {"from": "route", "to": "pending", "label": "Delete pending and invalidate cache", "activate": false},
    {"from": "route", "to": "app", "label": "Confirmation result", "return": true},
    {"from": "app", "to": "user", "label": "Success message", "return": true}
  ]
}
