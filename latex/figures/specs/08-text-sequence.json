    {"from": "route", "to": "pending", "label": "Xóa pending + invalidate cache", "activate": false},
    {"from": "route", "to": "app", "label": "Kết quả xác nhận", "return": true},
    {"from": "app", "to": "user", "label": "Thông báo thành công", "return": true}
