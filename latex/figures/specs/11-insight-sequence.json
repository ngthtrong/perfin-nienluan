{
  "title": "Grounded Insight Generation",
  "participants": [
    {"id": "user", "label": "User", "actor": true},
    {"id": "screen", "label": "Report Screen"},
    {"id": "route", "label": "Report Route"},
    {"id": "analytics", "label": "Analytics Engine"},
    {"id": "db", "label": "PostgreSQL"},
    {"id": "cache", "label": "KV / Redis"},
    {"id": "persona", "label": "Persona Service"},
    {"id": "llm", "label": "LLM Narrator"}
  ],
  "messages": [
    {"from": "user", "to": "screen", "label": "Open report or request insight", "activate": false},
    {"from": "screen", "to": "route", "label": "GET /api/reports/insights"},
    {"from": "route", "to": "analytics", "label": "buildInsightFacts(user, payday)"},
    {"from": "analytics", "to": "cache", "label": "GET cache:insights:user"},
    {"from": "cache", "to": "analytics", "label": "Miss or cached facts", "return": true},
    {"from": "analytics", "to": "db", "label": "Query monthly, daily, category and wallet series"},
    {"from": "db", "to": "analytics", "label": "Structured numeric data", "return": true},
    {"from": "analytics", "to": "analytics", "label": "Regression · z-score/IQR · runway · Pearson"},
    {"note": "Numbers come only from deterministic algorithms", "over": "analytics"},
    {"from": "analytics", "to": "cache", "label": "SET facts TTL", "activate": false},
    {"from": "analytics", "to": "route", "label": "Insight facts", "return": true},
    {"from": "route", "to": "persona", "label": "Load consented style prompt"},
    {"from": "persona", "to": "route", "label": "Active persona", "return": true},
    {"from": "route", "to": "llm", "label": "Narrate(facts, persona); do not invent numbers"},
    {"from": "llm", "to": "route", "label": "Narration or template fallback", "return": true},
    {"from": "route", "to": "screen", "label": "facts + narration + provider_used", "return": true},
    {"from": "screen", "to": "user", "label": "Consistent chart and explanation", "return": true}
  ]
}
