          <mxGeometry x="1440" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="Mở báo cáo / hỏi insight" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0891;entryX=0.5;entryY=0.0891;" edge="1" parent="1" source="user" target="app">
