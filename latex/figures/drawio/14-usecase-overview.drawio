        <mxCell id="n1" value="How to read: each actor appears once. Its associations use a dedicated vertical corridor and branch horizontally to the related use cases, which avoids crossing connectors." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=9;spacingRight=8;fillColor=#F7F9FB;strokeColor=#9AA7B4;fontColor=#3D4B5A;fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1">
