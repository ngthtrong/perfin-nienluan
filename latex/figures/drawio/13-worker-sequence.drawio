<mxfile>
  <diagram id="seqlayout" name="Tác vụ chủ động và chống trùng">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="scheduler" value="BullMQ Scheduler" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Redis Queue" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Worker Process" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="analytics" value="Deterministic Services" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1000" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="narrator" value="Persona / LLM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1240" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="chat" value="Internal Message" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1480" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Mobile App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1720" y="40" width="100" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="Upsert recurring schedules" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0891;entryX=0.5;entryY=0.0891;" edge="1" parent="1" source="scheduler" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="Job + attempts + exponential backoff" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1386;entryX=0.5;entryY=0.1386;" edge="1" parent="1" source="redis" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="Resolve user scope / due data" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1881;entryX=0.5;entryY=0.1881;" edge="1" parent="1" source="worker" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="Bills, balances, transactions" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.2376;entryX=0.5;entryY=0.2376;" edge="1" parent="1" source="db" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="Run reminder / runway / subscription / month-end" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2871;entryX=0.5;entryY=0.2871;" edge="1" parent="1" source="worker" target="analytics">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="Tính facts và ngưỡng cảnh báo" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3366;entryX=0.5;entryY=0.3663;" edge="1" parent="1" source="analytics" target="analytics">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1110" y="380"/><mxPoint x="1110" y="410"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="Structured facts" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.4059;entryX=0.5;entryY=0.4059;" edge="1" parent="1" source="analytics" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="Trang trí persona; month-end có grounded narration" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4554;entryX=0.5;entryY=0.4554;" edge="1" parent="1" source="worker" target="narrator">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="Message hoặc deterministic fallback" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.505;entryX=0.5;entryY=0.505;" edge="1" parent="1" source="narrator" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="persist(event_key, dedupeHours)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5545;entryX=0.5;entryY=0.5545;" edge="1" parent="1" source="worker" target="chat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="INSERT chat_messages với unique event_key" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.604;entryX=0.5;entryY=0.604;" edge="1" parent="1" source="chat" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="created hoặc duplicate" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.6535;entryX=0.5;entryY=0.6535;" edge="1" parent="1" source="db" target="chat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="Idempotent result" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.703;entryX=0.5;entryY=0.703;" edge="1" parent="1" source="chat" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="Complete; retry nếu lỗi" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.7525;entryX=0.5;entryY=0.7525;" edge="1" parent="1" source="worker" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m14" value="GET /api/chat/messages" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.802;entryX=0.5;entryY=0.802;" edge="1" parent="1" source="app" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m15" value="Thông báo chủ động đã lưu" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.8515;entryX=0.5;entryY=0.8515;" edge="1" parent="1" source="db" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note16" value="Nếu Redis không khả dụng, worker tắt an toàn; API tương tác vẫn chạy" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="930" width="180" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
