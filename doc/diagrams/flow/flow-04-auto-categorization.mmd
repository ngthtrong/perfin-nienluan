---
title: "Luồng 4 — Phân loại thông minh + Feedback Loop (Auto-Categorization)"
---
flowchart TD
    START(["Giao dịch từ bất kỳ nguồn:\nText / Voice / OCR"]) --> AI_CAT

    subgraph AI_CAT["AI gợi ý danh mục"]
        G1[Gemini phân tích toàn bộ câu\n→ Trả category_name\nvd: 'Y tế' từ 'grab đi bệnh viện']
        G2["Hiểu ngữ cảnh đầy đủ:\n'grab bệnh viện' → Y tế ✅\n'grab về nhà' → Di chuyển ✅"]
        G1 --- G2
    end

    AI_CAT --> MATCH

    subgraph MATCH["matchCategory() — 3 tầng so khớp"]
        M1[Exact match trong DB] -->|Khớp| FOUND
        M1 -->|Không| M2[Partial / Substring match]
        M2 -->|Khớp| FOUND
        M2 -->|Không| M3[CATEGORY_ALIASES lookup\nvd: 'cà phê' → Ăn uống]
        M3 -->|Khớp alias| FOUND
        M3 -->|Không khớp| FALLBACK[Fallback → Danh mục 'Khác']
        FOUND[category_id từ DB]
    end

    FOUND --> PREVIEW[TransactionPreviewCard\nhiển thị danh mục gợi ý]
    FALLBACK --> PREVIEW

    PREVIEW --> USER_ACT{User action?}

    USER_ACT -->|Chấp nhận| CONFIRM[POST /confirm\n→ Lưu DB với danh mục gợi ý]
    USER_ACT -->|Sửa danh mục| EDIT_CAT[POST /edit\n{category_name mới}]
    EDIT_CAT --> UPDATE[pending.update\n→ preview mới]
    UPDATE --> USER_ACT

    CONFIRM --> SAVED[Giao dịch lưu DB\nvới category_id cuối cùng]

    SAVED --> LOOP

    subgraph LOOP["Feedback Loop — dự kiến"]
        L1[Ghi nhận: user thường phân loại\n'grab bệnh viện' → Y tế]
        L2[Dùng làm few-shot context\ncho lần parse tiếp theo]
        L3["AI nhắn gợi ý danh mục mới\nnếu đủ pattern (Luồng 14)"]
        L1 --> L2 --> L3
    end

    style FOUND fill:#d4edda,stroke:#28a745
    style FALLBACK fill:#fff3cd,stroke:#ffc107
    style CONFIRM fill:#d4edda,stroke:#28a745
    style LOOP stroke-dasharray: 5 5,fill:#f0f0f0
    style G2 fill:#e3f2fd,stroke:#1976d2
