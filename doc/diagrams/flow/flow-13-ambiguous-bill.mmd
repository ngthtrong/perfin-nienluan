---
title: "Luồng 13 — Clarification khi Tên Bill Mơ Hồ"
---
flowchart TD
    START([User nhắn lệnh liên quan\nrecurring bill]) --> PARSE[Gemini parse\nextract intent + name]

    PARSE --> DISPATCH{intent?}

    DISPATCH -->|recurring_pause| PAUSE[handleRecurringPause]
    DISPATCH -->|recurring_pay| PAY[handleRecurringPay]
    DISPATCH -->|recurring_history| HIST[handleRecurringHistory]

    subgraph FIND["findBillByName(name)"]
        F1[RecurringBillModel.getAll\n→ Lấy toàn bộ bills của user]
        F1 --> F2[So khớp Exact match]
        F2 -->|Đúng 1 kết quả| EXACT[Trả bill]
        F2 -->|Không đúng| F3[So khớp Partial / Substring]
        F3 -->|Đúng 1 kết quả| PARTIAL[Trả bill]
        F3 -->|Nhiều kết quả| MULTI[Trả candidates]
        F3 -->|0 kết quả| NONE[Trả null]
    end

    PAUSE --> F1
    HIST --> F1

    EXACT --> EXEC[Thực thi hành động\npause / history]
    PARTIAL --> EXEC

    MULTI --> CLAR1[type = clarification\nLiệt kê danh sách:\n• Bill A\n• Bill B]
    NONE --> ERR[type = chat_response\n'Không tìm thấy khoản đó']

    CLAR1 --> RETRY([User trả lời tên rõ hơn\n→ Gửi lại message])
    RETRY --> PARSE

    PAY --> PAYCHECK{name được nêu?}
    PAYCHECK -->|Có tên| F1
    PAYCHECK -->|Không có tên\n'đã trả rồi'| GETDUE[getDueBills\n→ Bills đến hạn hôm nay]

    GETDUE --> DUE{Số lượng due bills?}
    DUE -->|Đúng 1 bill| TARGET[Xác định target bill]
    DUE -->|Nhiều bills| CLAR2[type = clarification\nBạn vừa thanh toán khoản nào?\n• Tiền phòng trọ\n• Tiền điện]
    DUE -->|0 bills| NOB[type = chat_response\n'Không có khoản nào đến hạn']

    CLAR2 --> RETRY2([User trả lời tên cụ thể\n→ Gửi lại message])
    RETRY2 --> PARSE

    TARGET --> OVERRIDE{Có override amount?}
    OVERRIDE -->|Có| PAYWITH[Ghi nhận với\nsố tiền override]
    OVERRIDE -->|Không| PAYFIX[Ghi nhận với\nsố tiền cố định]
    PAYWITH --> DONE[system_message:\nĐã ghi nhận + số dư ví]
    PAYFIX --> DONE

    EXEC --> DONE

    style EXACT fill:#d4edda,stroke:#28a745
    style PARTIAL fill:#d4edda,stroke:#28a745
    style CLAR1 fill:#fff3cd,stroke:#ffc107
    style CLAR2 fill:#fff3cd,stroke:#ffc107
    style ERR fill:#f8d7da,stroke:#dc3545
    style NOB fill:#f8d7da,stroke:#dc3545
    style DONE fill:#d4edda,stroke:#28a745
