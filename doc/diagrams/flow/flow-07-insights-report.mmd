---
title: "Luồng 7 — Phân tích & Báo cáo cá nhân hóa (Personalized Insights)"
---
flowchart TD
    START1([User nhắn:\n'phân tích chi tiêu tháng này']) --> CHAT_REQ
    START2([User nhấn Report tab]) --> REPORT_REQ

    CHAT_REQ[POST /api/chat/message\nintent = report_request] --> SERVICE
    REPORT_REQ[GET /api/report?month=...] --> SERVICE

    SERVICE[report.service.js\nTruy vấn DB] --> STATS

    subgraph STATS["Tính toán thống kê"]
        S1[Tổng thu / Tổng chi / Số dư]
        S2[Top N danh mục chi nhiều nhất]
        S3[So sánh kỳ trước: % thay đổi]
        S4[Tiến độ ngân sách theo danh mục]
        S1 --- S2 --- S3 --- S4
    end

    STATS --> LLM_PROMPT[Gửi data + context\nlên Gemini với prompt\nphân tích chuyên sâu]

    LLM_PROMPT --> INSIGHT

    subgraph INSIGHT["LLM phân tích — vượt ra ngoài số liệu"]
        I1["Xu hướng bất thường:\n'Grab tháng này +40% so tháng trước'"]
        I2["Pattern ẩn:\n'Tiêu nhiều hơn vào cuối tuần'"]
        I3["Cross-category insight:\n'Tuần OT nhiều → ăn ngoài & grab tăng'"]
        I4["Dự đoán xu hướng:\n'Nếu tiếp tục, tháng tới vượt 5tr'"]
        I5["Gợi ý cải thiện cụ thể"]
        I1 --- I2 --- I3 --- I4 --- I5
    end

    INSIGHT --> RETURN[Trả về:\n- data: số liệu cho biểu đồ\n- ai_comment: nhận xét AI]

    RETURN --> FRONTEND[Frontend:\n- Render biểu đồ / charts\n- Hiển thị ai_comment trong chat]

    RETURN --> PERSONA[applyPersona\n→ Format nhận xét\ntheo persona - dự kiến]

    style STATS fill:#e3f2fd,stroke:#1976d2
    style INSIGHT fill:#f3e5f5,stroke:#7b1fa2
    style RETURN fill:#d4edda,stroke:#28a745
    style PERSONA stroke-dasharray: 5 5
